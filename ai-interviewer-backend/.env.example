# Groq API key (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Sarvam API key (https://www.sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here

# Tavus AI Configuration (https://www.tavus.io)
TAVUS_API_KEY=your_tavus_api_key_here
TAVUS_PERSONA_ID=your_tavus_persona_id_here
TAVUS_REPLICA_ID=your_tavus_replica_id_here

# Server Configuration
PORT=5000
FLASK_ENV=development
FLASK_DEBUG=true

# Groq Model Settings
GROQ_MODEL=llama3-8b-8192
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.7

# CORS — frontend origin allowed to call this service
FRONTEND_URL=http://localhost:5173

# Node.js backend URL (for inter-service calls if needed)
BACKEND_URL=http://localhost:4000/api
