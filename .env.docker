# Docker environment variables
# Copy this file and fill in your values before running docker-compose

MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/placeOprep
PORT=4000
PY_ENGINE_URL=http://ai-engine:5000
JWT_SECRET=replace_with_docker_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_docker_refresh_secret_min_32_chars
ONECOMPILER_API_KEY=your_onecompiler_api_key_here
FRONTEND_URL=http://localhost:5173

# Redis (used by LiveKit)
REDIS_URL=redis://redis:6379

# LiveKit
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=ws://livekit:7880
